{
  "name": "rpa-social-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "Hệ thống RPA Social Automation - Studio & Agent tự động hóa mạng xã hội",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && set NODE_ENV=development && electron . --dev\"",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "rebuild": "node scripts/rebuild-native.js",
    "postinstall": "echo Native modules need manual rebuild: npm run rebuild",
    "rebuild:manual": "@electron/rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@electron/rebuild": "^3.6.0",
    "@reduxjs/toolkit": "^2.3.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^11.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.460.0",
    "puppeteer": "^22.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
